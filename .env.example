# FastAPI task service (all external addresses are full URLs).
DOUHOT_HOTSPOT_API_URL=https://tk.jdword.com/feisu/focus/inspiration/hotspotList
DOUHOT_INDUSTRY_API_URL=https://focus.jdword.com/feisu/focus/inspiration/industryNameList
DOUHOT_COOKIE_API_URL=https://focus.jdword.com/feisu/focus/import/getCookieConfig
DOUHOT_RANKING_API_URL=https://focus.jdword.com/feisu/focus/import/rankingViralVideo
DOUHOT_INDUSTRY_RANKING_API_URL=https://focus.jdword.com/feisu/focus//import/rankingViralVideoByIndustry
EXTRACT_API_URL=http://your-api-host:28600/api/v1/videos/extract
DOUHOT_HOTSPOT_OPEN_ID=replace-with-open-id
DOUHOT_HOTSPOT_SIZE=30
DOUHOT_INDUSTRY_SIZE=30

# Use an absolute path on the server, for example /var/lib/douhot-crawler.
DOUHOT_API_DATA_ROOT=/absolute/path/to/douhot-api-data
DOUHOT_API_HOST=127.0.0.1
DOUHOT_API_PORT=8000
DOUHOT_API_WORKERS=1
DOUHOT_MAX_VIDEOS_PER_KEYWORD=3
DOUHOT_MAX_CANDIDATES_PER_KEYWORD=15
DOUHOT_DAILY_ENABLED=true
DOUHOT_DAILY_TIME=03:00
DOUHOT_DAILY_API_URL=http://127.0.0.1:8000

# Existing MCP service settings.
DOUHOT_MCP_TOKEN=replace-with-a-long-random-token
DOUHOT_MCP_HOST=127.0.0.1
DOUHOT_MCP_PORT=8765
DOUHOT_PUBLIC_URL=http://127.0.0.1:8765
DOUHOT_DOWNLOAD_SECRET=replace-with-another-long-random-secret
# DOUHOT_DATA_ROOT=/absolute/path/to/douhot-data
